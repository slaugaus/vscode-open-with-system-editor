{
  "name": "open-with-system",
  "displayName": "Open with System Editor",
  "description": "Registers a custom editor that opens files externally.",
  "version": "0.2.0",
  "publisher": "slaugaus",
  "icon": "./rsrc/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "keywords": [
    "open",
    "file",
    "default application"
  ],
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/slaugaus/vscode-open-with-system-editor"
  },
  "homepage": "https://github.com/slaugaus/vscode-open-with-system-editor",
  "bugs": {
    "url": "https://github.com/slaugaus/vscode-open-with-system-editor/issues"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "open-with-system",
        "priority": "option",
        "displayName": "System Editor",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "npm-run-all2": "9.0.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "tiny-open": "1.3.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": true
  }
}